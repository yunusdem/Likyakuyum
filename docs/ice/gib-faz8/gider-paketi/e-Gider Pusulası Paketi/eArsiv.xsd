		<xs:sequence>
			<xs:element name="vergiAdi" type="earsiv:vergiTipEnum"/>
			<xs:element name="vergiTutar">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:totalDigits value="18"/>
						<xs:fractionDigits value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="satisType">
