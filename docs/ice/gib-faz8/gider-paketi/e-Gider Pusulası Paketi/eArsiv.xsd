	xmlns:xades141="http://uri.etsi.org/01903/v1.4.1#" elementFormDefault="qualified"
	attributeFormDefault="unqualified" xmlns:ns1="http://zraporu.efatura.gov.tr">
	<xs:import namespace="http://uri.etsi.org/01903/v1.3.2#" schemaLocation="XAdES.xsd"/>
	<xs:import namespace="http://uri.etsi.org/01903/v1.4.1#" schemaLocation="XAdESv141.xsd"/>
	<xs:import namespace="http://www.w3.org/2000/09/xmldsig#"
		schemaLocation="xmldsig-core-schema.xsd"/>
	<xs:element name="eArsivRaporu">
		<xs:annotation>
			<xs:documentation>eArsiv Rapor Bilgileri.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="baslik" type="earsiv:baslikType" maxOccurs="1" minOccurs="1"/>
				<xs:choice minOccurs="1" maxOccurs="unbounded">
					<xs:element name="eGiderPusulasi" maxOccurs="unbounded" minOccurs="0"
						type="earsiv:eGiderPusulasiType"/>
					<xs:element name="eGiderPusulasiIptal" minOccurs="0" maxOccurs="unbounded">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="giderPusulasiBelgeNo" type="earsiv:idType"/>
								<xs:element name="UUID" type="earsiv:uuidType"/>
								<xs:element name="iptalTarihi" type="xs:date"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
		<xs:unique name="GiderPusulasiUUID">
			<xs:selector xpath="earsiv:eGiderPusulasi"/>
			<xs:field xpath="earsiv:UUID"/>
		</xs:unique>
		<xs:unique name="GiderPusulasiBelgeNo">
			<xs:selector xpath="earsiv:eGiderPusulasi"/>
			<xs:field xpath="earsiv:GiderPusulasiBelgeNo"/>
		</xs:unique>
	</xs:element>
	<xs:complexType name="baslikType">
		<xs:sequence>
			<xs:element name="versiyon" type="xs:string"/>
			<xs:element name="mukellef" type="earsiv:vknTcknType"/>
			<xs:element name="hazirlayan" type="earsiv:vknTcknType"/>
			<xs:element name="raporNo" type="earsiv:uuidType"/>
			<xs:element name="donemBaslangicTarihi" type="xs:date"/>
			<xs:element name="donemBitisTarihi" type="xs:date"/>
			<xs:element name="bolumBaslangicTarihi" type="xs:date"/>
			<xs:element name="bolumBitisTarihi" type="xs:date"/>
			<xs:element name="bolumNo" type="xs:int"/>
			<xs:element ref="ds:Signature"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="vknType">
		<xs:restriction base="xs:string">
			<xs:pattern value="\d\d\d\d\d\d\d\d\d\d"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tcknType">
		<xs:restriction base="xs:string">
			<xs:pattern value="\d\d\d\d\d\d\d\d\d\d\d"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="idType">
		<xs:restriction base="xs:string">
			<xs:length value="16"/>
			<xs:pattern value="[A-Za-z0-9]{3}20[0-9]{2}[0-9]{9}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="vknTcknType">
		<xs:choice>
			<xs:element name="vkn" type="earsiv:vknType"/>
			<xs:element name="tckn" type="earsiv:tcknType"/>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="secimliKisiType">
		<xs:choice>
			<!-- Gerçek Kişi -->
			<xs:element name="gercekKisi">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="tckn" type="earsiv:tcknType"/>
						<xs:element name="adiSoyadi">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:minLength value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<xs:element name="yabanci">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="pasaportNo" type="xs:string"/>
						<xs:element name="adiSoyadi">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:minLength value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="iadeDetayType">
		<xs:sequence>
			<xs:element name="iadeBelgeTip" type="earsiv:iadeDetayEnum"/>
			<xs:element name="belgeNo" type="xs:string"/>
			<xs:element name="belgeTarihi" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="kargoBilgiType">
		<xs:sequence>
			<xs:element name="yetkiBelgeNo" type="xs:string"/>
			<xs:element name="vkn" type="earsiv:vknType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="iadeKullanımType">
		<xs:sequence>
			<xs:element name="yontem" type="earsiv:yontemTypeEnum"/>
			<xs:element name="saglayiciAdi" type="xs:string"/>
			<xs:element name="vkn" type="earsiv:vknType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="kisiType">
		<xs:sequence>
			<xs:element name="tuzelKisi" minOccurs="0" maxOccurs="1">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="vkn" type="earsiv:vknType"/>
						<xs:element name="unvan">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:minLength value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="gercekKisi" minOccurs="0" maxOccurs="1">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="tckn" type="earsiv:tcknType"/>
