									<xs:minLength value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="aliciType">
		<xs:sequence>
			<xs:element name="kisi" type="earsiv:secimliKisiType"/>
			<xs:element name="bilgiDetay" minOccurs="1" maxOccurs="1">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="kod" type="xs:string"/>
						<xs:element name="tip" type="earsiv:ContactTypeEnum"/>
						<xs:element name="telefon">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:pattern value="0[1-9][0-9]{9}"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="iadeDetayEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="EARSIV_FATURA"/>
			<xs:enumeration value="BELGESIZ"/>
			<xs:enumeration value="SATIS_FISI"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="yontemTypeEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="IADE_PROVIDER"/>
			<xs:enumeration value="SMS_PROVIDER"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="odemeTipEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="KREDIKARTI/BANKAKARTI"/>
			<xs:enumeration value="EFT/HAVALE"/>
			<xs:enumeration value="KAPIDAODEME"/>
			<xs:enumeration value="ODEMEARACISI"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ContactTypeEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="IADEKODU"/>
			<xs:enumeration value="SMS"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="odemeTipDiger">
		<xs:restriction base="xs:string">
			<xs:pattern value="DIGER - \S.*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="odemeTip">
		<xs:union memberTypes="earsiv:odemeTipEnum earsiv:odemeTipDiger"/>
	</xs:simpleType>

	<xs:simpleType name="timeType">
		<xs:restriction base="xs:time">
			<xs:pattern value="(([01][0-9])|(2[0-3]))(:[0-5][0-9]){2}(\.[0-9]+)?"/>
			<xs:minInclusive value="00:00:00"/>
		</xs:restriction>
	</xs:simpleType>
