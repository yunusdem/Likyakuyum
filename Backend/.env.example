# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Configuration (Comma separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# JWT Authentication Secrets
JWT_ACCESS_SECRET=kuyumcu_erp_super_secret_access_jwt_key_2026_!@#$
JWT_REFRESH_SECRET=kuyumcu_erp_super_secret_refresh_jwt_key_2026_!@#$
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging Level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info

# Ana admin paneli (admin.likyakuyum.com) - ayri veritabani: docs/sql/LIKYA_ADMIN.sql
# ADMIN_DB_USER, ADMIN_DB_PASSWORD, ADMIN_JWT_SECRET veya ADMIN_DB_ENC_KEY bos ise admin API'si kapali kalir.
ADMIN_DB_SERVER=localhost
ADMIN_DB_PORT=1433
ADMIN_DB_NAME=LIKYA_ADMIN
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=
# En az 32 karakter, rastgele. Uretmek icin: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_JWT_SECRET=
# Firma veritabani sifrelerini sifreli saklamak icin; en az 32 karakter, ayni komutla uretin. SONRADAN DEGISTIRMEYIN.
ADMIN_DB_ENC_KEY=
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_ORIGIN=http://admin.likyakuyum.com,https://admin.likyakuyum.com,http://localhost:3001
# Kullanici girisinin merkez kontrolunden gecmesi: kapali | zorunlu. Tum firmalar panelde tanimlanip
# kullanicilari ice aktarilmadan zorunlu YAPMAYIN.
MERKEZ_GIRIS=kapali

# Mail gonderimi (yonetim paneli: firma e-posta dogrulamasi). SMTP_HOST veya SMTP_FROM bos ise mail ozelligi kapalidir.
# Sunucuda bu satirlar Backend/.env.local dosyasina yazilir (git izlemez).
# SMTP_SECURE: true = 465 (dogrudan TLS), false = 587 / 25 (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Maillerdeki baglantilarin basi (yonetim panelinin dis adresi)
ADMIN_PANEL_URL=https://admin.likyakuyum.com
