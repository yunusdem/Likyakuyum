# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Configuration (Comma separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# JWT Authentication Secrets
JWT_ACCESS_SECRET=kuyumcu_erp_super_secret_access_jwt_key_2026_!@#$
JWT_REFRESH_SECRET=kuyumcu_erp_super_secret_refresh_jwt_key_2026_!@#$
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging Level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info
